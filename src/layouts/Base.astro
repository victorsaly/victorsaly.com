---
/*
 * One layout for every page: what a search engine or a link preview reads, the self-hosted faces, the
 * reader's font and theme choices restored before first paint (so nothing flashes), the skip link, the
 * header and the footer. Pages add only content, inside their own <main id="main">.
 */
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** canonical path, e.g. "/" or "/privacy" */
  path: string;
  /** social-card image path; the site-wide og.png unless a page has a better one */
  image?: string;
  imageAlt?: string;
}
const { title, description, path, image = '/og.png', imageAlt } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const ogAlt =
  imageAlt ??
  'Victor Saly: I build small web things that do one job well. Beside it, a linocut portrait of him. victorsaly.com';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Victor Saly" />
    <link rel="me" href="https://www.linkedin.com/in/victorsaly" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Victor Saly" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1c1c1c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/atkinson-hyperlegible-400.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/atkinson-hyperlegible-700.woff2"
      crossorigin
    />

    <script is:inline>
      // Restore the reader's font and theme choices before first paint. Stored per browser; failures are
      // fine.
      try {
        const font = localStorage.getItem('font');
        if (font === 'switch') document.documentElement.dataset.font = 'switch';
        // The arcade design saved the theme as theme-pref; carry a returning visitor's choice over once.
        let theme = localStorage.getItem('theme');
        const legacy = localStorage.getItem('theme-pref');
        if (theme === null && (legacy === 'light' || legacy === 'dark')) {
          theme = legacy;
          localStorage.setItem('theme', legacy);
        }
        if (legacy !== null) localStorage.removeItem('theme-pref');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <slot />
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -100%;
    background: var(--paper);
    padding: var(--space-2) var(--space-3);
    border: var(--rule-width) solid var(--ink);
  }
  .skip:focus {
    top: var(--space-2);
    z-index: 11;
  }
</style>

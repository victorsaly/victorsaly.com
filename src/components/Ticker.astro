---
/* The marquee strip. The phrase list is doubled so the -50% translate loops
   seamlessly; the mask fades both ends. */
const phrases = [
  'Games', 'Learning tools', 'Web Audio', 'Offline first',
  'No accounts', 'No analytics', 'Built with the kids',
];
const strip = [...phrases, ...phrases].join(' · ') + ' · ';
---
<div class="ticker" aria-hidden="true">
  <span>{strip}</span>
</div>

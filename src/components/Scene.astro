---
/*
 * The workbench: a shut-the-box rack losing a tile, two dice mid-bounce,
 * notes off the top, drawn by hand and moved by CSS (see global.css).
 * Decorative only.
 */
---

<div class="scene reveal" style="--i:2" aria-hidden="true">
  <svg viewBox="0 0 320 300" role="presentation">
    <!-- tile rack -->
    <g>
      <rect x="30" y="106" width="216" height="12" rx="6" fill="var(--line)"></rect>
      <g class="s-tile-1">
        <rect
          x="38"
          y="40"
          width="44"
          height="64"
          rx="9"
          fill="var(--card)"
          stroke="var(--ink)"
          stroke-width="2.5"></rect>
        <text
          x="60"
          y="82"
          text-anchor="middle"
          font-family="var(--display)"
          font-weight="600"
          font-size="28"
          fill="var(--ink)">1</text
        >
      </g>
      <g class="s-tile-2">
        <rect
          x="90"
          y="40"
          width="44"
          height="64"
          rx="9"
          fill="var(--card)"
          stroke="var(--ink)"
          stroke-width="2.5"></rect>
        <text
          x="112"
          y="82"
          text-anchor="middle"
          font-family="var(--display)"
          font-weight="600"
          font-size="28"
          fill="var(--ink)">2</text
        >
      </g>
      <g class="s-tile-3">
        <rect
          x="142"
          y="40"
          width="44"
          height="64"
          rx="9"
          fill="var(--plate)"
          stroke="var(--ink)"
          stroke-width="2.5"></rect>
        <text
          x="164"
          y="82"
          text-anchor="middle"
          font-family="var(--display)"
          font-weight="600"
          font-size="28"
          fill="var(--plate-ink)">3</text
        >
      </g>
      <g class="s-tile-4">
        <rect
          x="194"
          y="40"
          width="44"
          height="64"
          rx="9"
          fill="var(--card)"
          stroke="var(--ink)"
          stroke-width="2.5"></rect>
        <text
          x="216"
          y="82"
          text-anchor="middle"
          font-family="var(--display)"
          font-weight="600"
          font-size="28"
          fill="var(--ink)">4</text
        >
      </g>
    </g>

    <!-- dice -->
    <g class="s-die-a">
      <rect
        x="52"
        y="164"
        width="58"
        height="58"
        rx="12"
        transform="rotate(-8 81 193)"
        fill="var(--card)"
        stroke="var(--ink)"
        stroke-width="2.5"></rect>
      <g fill="var(--accent)" transform="rotate(-8 81 193)">
        <circle cx="67" cy="179" r="4.5"></circle><circle cx="95" cy="179" r="4.5"></circle>
        <circle cx="81" cy="193" r="4.5"></circle>
        <circle cx="67" cy="207" r="4.5"></circle><circle cx="95" cy="207" r="4.5"></circle>
      </g>
    </g>
    <g class="s-die-b">
      <rect
        x="150"
        y="188"
        width="46"
        height="46"
        rx="10"
        transform="rotate(10 173 211)"
        fill="var(--plate)"
        stroke="var(--ink)"
        stroke-width="2.5"></rect>
      <g fill="var(--plate-ink)" transform="rotate(10 173 211)">
        <circle cx="162" cy="200" r="4"></circle><circle cx="173" cy="211" r="4"></circle><circle
          cx="184"
          cy="222"
          r="4"></circle>
      </g>
    </g>

    <!-- notes drifting up -->
    <g
      class="s-note-a"
      fill="none"
      stroke="var(--accent)"
      stroke-width="2.5"
      stroke-linecap="round"
    >
      <circle cx="262" cy="176" r="6" fill="var(--accent)" stroke="none"></circle>
      <path d="M268 176 V148 q8 2 14 -4"></path>
    </g>
    <g class="s-note-b" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round">
      <circle cx="288" cy="212" r="5" fill="var(--muted)" stroke="none"></circle>
      <path d="M293 212 V188"></path>
    </g>

    <!-- sparkles -->
    <path
      class="s-spark-a"
      d="M282 52 v20 M272 62 h20"
      stroke="var(--accent)"
      stroke-width="2.5"
      stroke-linecap="round"></path>
    <path
      class="s-spark-b"
      d="M26 150 v14 M19 157 h14"
      stroke="var(--muted)"
      stroke-width="2.5"
      stroke-linecap="round"></path>

    <!-- the caret, still typing -->
    <g font-family="var(--mono)" font-size="15" fill="var(--muted)">
      <text x="52" y="266">&gt;_</text>
      <rect class="s-cursor" x="76" y="254" width="9" height="15" fill="var(--accent)"></rect>
    </g>
  </svg>
</div>

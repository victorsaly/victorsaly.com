---
import type { LiveProject } from '../data/projects';

interface Props {
  project: LiveProject;
  index: number;
}
const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---
<li class="card reveal" style={`--i:${index % 2}`}>
  <!-- The screenshot repeats the title link, so keep it out of the tab order. -->
  <a class="card-shot" href={project.url} tabindex="-1" aria-hidden="true">
    <img src={project.shot} alt={project.shotAlt} width="800" height="500" loading="lazy" decoding="async">
    <span class="card-num">{num}</span>
  </a>
  <div class="card-head">
    <h3><a href={project.url}>{project.title}</a></h3>
    <span class="host">{project.host}</span>
  </div>
  <p>{project.description}</p>
  <ul class="meta">
    {project.tech.map((t) => <li>{t}</li>)}
  </ul>
</li>

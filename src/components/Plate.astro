---
/*
 * A plate: one project as a page of a printed catalogue. A strong rule opens it; its real screen sits in a
 * hairline frame on the left; on the right, its number (quiet, so the title leads), its title as the
 * plate's one marigold mark, what it does, a short facts table, and two ways in: open the thing itself
 * (in a new tab, so this page stays where the reader left it), or read how it was built. The screen carries
 * a view-transition name, so it travels into its page. Screens are in colour: the apps are colourful, and
 * that is how a game tells itself apart from a dashboard at a glance.
 *
 * A project with a film plays six silent seconds of it over the screen while a mouse is on the plate: the
 * one moving thing on the page. Nothing is fetched until then, and it never plays on a touch screen or for
 * a reader who asked for less motion.
 */
import type { WorkEntry } from '../lib/projects';
import { previewOf } from '../lib/media';

interface Props {
  project: WorkEntry;
  number: number;
  /** the first plate is in the first screen, so its picture loads eagerly */
  first?: boolean;
}

const { project: entry, number, first = false } = Astro.props;
const project = entry.data;
const slug = entry.id;
const page = `/work/${slug}`;
const repoLabel = project.repo?.replace(/^https:\/\/github\.com\//, '');
const preview = project.film ? previewOf(project.film) : undefined;
---

<article
  class="plate"
  id={`work-${slug}`}
  aria-labelledby={`plate-${slug}`}
  data-preview={preview ? '' : undefined}
>
  <a class="screen" href={page} tabindex="-1" aria-hidden="true">
    <img
      src={project.shot}
      alt=""
      width="800"
      height="500"
      loading={first ? 'eager' : 'lazy'}
      decoding="async"
      style={`view-transition-name: shot-${slug}`}
    />
    {
      preview && (
        <video
          class="preview"
          src={preview}
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          width="800"
          height="500"
        />
      )
    }
  </a>
  <div class="about">
    <p class="n" aria-hidden="true">{String(number).padStart(2, '0')}</p>
    <h3 id={`plate-${slug}`}>
      <a href={page}><mark>{project.title}</mark></a>
    </h3>
    <p class="what">{project.summary}</p>
    <dl class="facts">
      {
        project.madeFor && (
          <div>
            <dt>Made for</dt>
            <dd>{project.madeFor}</dd>
          </div>
        )
      }
      <div>
        <dt>Built with</dt>
        <dd>{project.tech.join(', ')}</dd>
      </div>
      <div>
        <dt>Source</dt>
        <dd>
          {
            project.repo ? (
              <>
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${repoLabel} (opens in a new tab)`}
                  set:text={repoLabel}
                />{' '}
                on GitHub
              </>
            ) : (
              'Private'
            )
          }
        </dd>
      </div>
    </dl>
    <p class="ways">
      <a class="control" href={project.url} target="_blank" rel="noopener">
        Open {project.host}
        <span class="visually-hidden"> (opens in a new tab)</span>
        <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M3 1h8v8M11 1 1 11" stroke="currentColor" stroke-width="1.75"></path>
        </svg>
      </a>
      <a class="control filled" href={page}>How it was built</a>
    </p>
  </div>
</article>

<style>
  .plate {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-4) var(--space-6);
    border-top: var(--rule-strong) solid var(--ink);
  }
  /* The preview sits exactly over the still and fades in once it is really playing, so a slow network
     shows the still rather than a black box. */
  .screen {
    position: relative;
  }
  .preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 240ms var(--ease-out);
  }
  .plate.playing .preview {
    opacity: 1;
  }
  .about {
    min-width: 0;
  }
  /* The number: quiet, small and tabular, so the title leads. */
  .n {
    margin: 0 0 var(--space-2);
    font-size: var(--size-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--quiet);
  }
  h3 {
    margin: 0;
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover mark,
  h3 a:focus-visible mark {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
  }
  .what {
    margin: var(--space-3) 0 var(--space-4);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .ways {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
  }

  @media (max-width: 52rem) {
    .plate {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding-bottom: var(--space-5);
    }
  }
</style>

<script>
  // Plays a plate's preview while a mouse is on the plate. Only for a fine pointer, and never when the
  // reader asked for less motion; the video downloads on the first hover, not before.
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  for (const plate of document.querySelectorAll<HTMLElement>('.plate[data-preview]')) {
    const video = plate.querySelector<HTMLVideoElement>('video.preview');
    if (!video) continue;
    plate.addEventListener('pointerenter', () => {
      if (!fine.matches || still.matches) return;
      video
        .play()
        .then(() => {
          // the pointer may have left while it was loading
          if (plate.matches(':hover')) plate.classList.add('playing');
          else video.pause();
        })
        .catch(() => {
          /* blocked or failed: the still stays, which is fine */
        });
    });
    plate.addEventListener('pointerleave', () => {
      plate.classList.remove('playing');
      video.pause();
    });
  }
</script>

---
/*
 * A plate: one project as a page of a printed catalogue. A strong rule opens it; its real screen sits in a
 * hairline frame on the left; on the right, its number (quiet, so the title leads), its title as the
 * plate's one marigold mark, what it does, a short facts table, and two ways in: open the thing itself,
 * or read how it was built. The screen carries a view-transition name, so it travels into its page.
 * On the catalogue the screens are printed in black and white, like the rest of the page; pointing at a
 * plate (or tabbing into it) brings its colour in. Its own page always shows it in colour.
 */
import type { LiveProject } from '../data/projects';

interface Props {
  project: LiveProject;
  number: number;
  /** the first plate is in the first screen, so its picture loads eagerly */
  first?: boolean;
}

const { project, number, first = false } = Astro.props;
const page = `/work/${project.slug}`;
const repoLabel = project.repo.replace(/^https:\/\/github\.com\//, '');
---

<article class="plate" aria-labelledby={`plate-${project.slug}`}>
  <a class="screen" href={page} tabindex="-1" aria-hidden="true">
    <img
      src={project.shot}
      alt=""
      width="800"
      height="500"
      loading={first ? 'eager' : 'lazy'}
      decoding="async"
      style={`view-transition-name: shot-${project.slug}`}
    />
  </a>
  <div class="about">
    <p class="n" aria-hidden="true">{String(number).padStart(2, '0')}</p>
    <h3 id={`plate-${project.slug}`}>
      <a href={page}><mark>{project.title}</mark></a>
    </h3>
    <p class="what">{project.description}</p>
    <dl class="facts">
      <div>
        <dt>Built with</dt>
        <dd>{project.tech.join(', ')}</dd>
      </div>
      <div>
        <dt>Source</dt>
        <dd><a href={project.repo}>{repoLabel}</a> on GitHub</dd>
      </div>
    </dl>
    <p class="ways">
      <a class="control" href={project.url}>
        Open {project.host}
        <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M3 1h8v8M11 1 1 11" stroke="currentColor" stroke-width="1.75"></path>
        </svg>
      </a>
      <a class="control filled" href={page}>How it was built</a>
    </p>
  </div>
</article>

<style>
  .plate {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-4) var(--space-6);
    border-top: var(--rule-strong) solid var(--ink);
  }
  .screen img {
    filter: grayscale(1);
    transition: filter 200ms ease;
  }
  .plate:focus-within .screen img {
    filter: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .plate:hover .screen img {
      filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .screen img {
      transition: none;
    }
  }
  .about {
    min-width: 0;
  }
  /* The number: quiet, small and tabular, so the title leads. */
  .n {
    margin: 0 0 var(--space-2);
    font-size: var(--size-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--quiet);
  }
  h3 {
    margin: 0;
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover mark,
  h3 a:focus-visible mark {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
  }
  .what {
    margin: var(--space-3) 0 var(--space-4);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .ways {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
  }

  @media (max-width: 52rem) {
    .plate {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding-bottom: var(--space-5);
    }
  }
</style>

---
/*
 * Not found: said plainly under the heavy rule, with the way back to the work and a way to report the
 * broken link.
 */
import Base from '../layouts/Base.astro';
---

<Base title="404 — Victor Saly" description="That page is not on the site." path="/404">
  <header class="frame page-head head">
    <h1 class="display">That page is not here.</h1>
    <p class="lede">
      It may have moved, or it may never have existed. Everything that is live sits on the home
      page.
    </p>
  </header>
  <main id="main" class="frame">
    <p class="ways">
      <a class="control filled" href="/">All the work</a>
      <a class="control" href="mailto:info@victorsaly.com">Report a broken link</a>
    </p>
  </main>
</Base>

<style>
  .head {
    padding-bottom: var(--space-4);
  }
  .display {
    max-width: 14ch;
  }
  .lede {
    margin: var(--space-4) 0 0;
    font-size: 1.3125rem;
  }
  .ways {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>

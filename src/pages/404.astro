---
import Base from '../layouts/Base.astro';
---
<Base
  title="404 — Victor Saly"
  description="That page is not on the board."
  path="/404"
>

  <header class="intro">
    <p class="kicker">Error &middot; tile not found</p>

    <!-- The board says it, so the heading doesn't have to shout: three
         tiles reading 4-0-4, and the middle one keeps shutting itself. -->
    <div class="scene board-404" aria-hidden="true">
      <svg viewBox="0 0 320 160" role="presentation">
        <rect x="30" y="126" width="260" height="12" rx="6" fill="var(--line)"/>
        <g class="s-tile-1">
          <rect x="42" y="40" width="66" height="84" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
          <text x="75" y="96" text-anchor="middle" font-family="var(--display)" font-weight="600" font-size="40" fill="var(--ink)">4</text>
        </g>
        <g class="s-tile-3">
          <rect x="127" y="40" width="66" height="84" rx="10" fill="var(--plate)" stroke="var(--ink)" stroke-width="2.5"/>
          <text x="160" y="96" text-anchor="middle" font-family="var(--display)" font-weight="600" font-size="40" fill="var(--plate-ink)">0</text>
        </g>
        <g class="s-tile-4">
          <rect x="212" y="40" width="66" height="84" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
          <text x="245" y="96" text-anchor="middle" font-family="var(--display)" font-weight="600" font-size="40" fill="var(--ink)">4</text>
        </g>
      </svg>
    </div>

    <h1>This page got <span class="plate-word">shut</span>.</h1>
    <p class="lede">The tile you rolled for is not on the board — it may have moved, or it may
      never have existed. Everything that is live sits on the home page.</p>
    <ul class="links">
      <li><a href="/">Roll again &rarr;</a></li>
      <li><a href="mailto:info@victorsaly.com">Report a broken link</a></li>
    </ul>
  </header>

</Base>

<style>
  .board-404 { max-width: 300px; margin: .5rem 0 1rem; }
</style>

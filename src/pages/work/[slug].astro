---
/*
 * A project's own page, built like a post on the blog: a heavy rule and the name set large, what it does
 * as the page's one marigold mark, then the real screen at full width (it arrives here from its plate by
 * view transition). Then the story at reading width, with the facts and the way in beside it, and the
 * next and previous plates at the bottom. Shut The Cube also carries today's leaderboards.
 */
import Base from '../../layouts/Base.astro';
import DailyBoards from '../../components/DailyBoards.astro';
import { render } from 'astro:content';
import { getWork } from '../../lib/projects';

export async function getStaticPaths() {
  const live = await getWork();
  // The list wraps: the first project's "previous" is the last one, and the other way round.
  return live.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      number: index + 1,
      prev: live.at(index - 1) ?? entry,
      next: live[(index + 1) % live.length] ?? entry,
    },
  }));
}

const { entry, number, prev, next } = Astro.props;
const project = entry.data;
const slug = entry.id;
const { Content } = await render(entry);
const repoLabel = project.repo.replace(/^https:\/\/github\.com\//, '');
// The message is the description's first sentence, marked; the rest follows in plain type.
const [message = project.summary, ...rest] = project.summary.split(/(?<=[.!?])\s+/);
---

<Base
  title={`${project.title} — Victor Saly`}
  description={project.summary}
  path={`/work/${slug}`}
  image={project.shot}
  imageAlt={project.shotAlt}
>
  <header class="frame page-head head">
    <p class="crumb small">
      <a href="/">All work</a>
      <span aria-hidden="true"> / </span>
      <span class="quiet">Project {String(number).padStart(2, '0')}</span>
    </p>
    <h1 class="display">{project.title}</h1>
    <p class="what"><mark>{message}</mark></p>
    {rest.length > 0 && <p class="what-rest">{rest.join(' ')}</p>}
  </header>

  <main id="main" class="frame">
    <figure class="shot">
      <div class="screen">
        <img
          src={project.shot}
          alt={project.shotAlt}
          width="800"
          height="500"
          decoding="async"
          style={`view-transition-name: shot-${slug}`}
        />
      </div>
    </figure>

    <div class="body">
      <section class="story" aria-labelledby="story">
        <h2 class="label" id="story">The story</h2>
        {
          project.film && (
            <figure class="film">
              <video
                src={project.film}
                poster={project.filmPoster}
                controls
                playsinline
                preload="none"
                width="1080"
                height="1920"
              >
                <track
                  kind="captions"
                  src={project.filmCaptions}
                  srclang="en"
                  label="English"
                  default
                />
              </video>
              {project.filmCaption && (
                <figcaption class="small quiet">{project.filmCaption}</figcaption>
              )}
            </figure>
          )
        }
        <Content />
      </section>

      <aside class="side" aria-labelledby="facts">
        <h2 class="label" id="facts">The facts</h2>
        <dl class="facts">
          <div>
            <dt>Built with</dt>
            <dd>{project.tech.join(', ')}</dd>
          </div>
          <div>
            <dt>Runs at</dt>
            <dd><a href={project.url}>{project.host}</a></dd>
          </div>
          <div>
            <dt>Source</dt>
            <dd><a href={project.repo}>{repoLabel}</a> on GitHub</dd>
          </div>
        </dl>
        <p class="ways">
          <a class="control filled" href={project.url}>
            Open {project.host}
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M3 1h8v8M11 1 1 11" stroke="currentColor" stroke-width="1.75"></path>
            </svg>
          </a>
        </p>
      </aside>
    </div>

    {slug === 'shut-the-cube' && <DailyBoards />}

    <nav class="more" aria-label="More projects">
      <a class="prev" href={`/work/${prev.id}`}>
        <span class="small quiet">Previous</span>
        <span class="t">{prev.data.title}</span>
      </a>
      <a class="next" href={`/work/${next.id}`}>
        <span class="small quiet">Next</span>
        <span class="t">{next.data.title}</span>
      </a>
    </nav>
  </main>
</Base>

<style>
  .head {
    padding-bottom: var(--space-5);
  }
  /* The way back up sits on the heavy rule, where the blog puts its page labels. */
  .crumb {
    margin: 0 0 var(--space-3);
    max-width: none;
  }
  .crumb a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-block: calc((var(--tap) - 1lh) / -2);
    font-weight: 700;
  }
  .what {
    margin: var(--space-4) 0 0;
    max-width: 38ch;
    font-size: var(--size-message);
    line-height: 1.35;
    letter-spacing: var(--tracking-message);
    font-weight: 700;
  }
  .what mark {
    padding: 0.1em 0.2em;
  }
  .what-rest {
    margin: var(--space-3) 0 0;
    max-width: 60ch;
    font-size: 1.1875rem;
  }

  .shot {
    margin: 0;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-6);
    margin-top: var(--space-5);
  }
  /* The story is rendered from Markdown, so its paragraphs are reached with :global. */
  .story :global(p) {
    margin: var(--space-3) 0 0;
  }
  .story .label + :global(p) {
    margin-top: var(--space-4);
  }
  .film {
    float: right;
    width: min(15rem, 45%);
    margin: var(--space-4) 0 var(--space-3) var(--space-4);
  }
  .film video {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-width) solid var(--ink);
    background: var(--ink);
  }
  .film figcaption {
    margin-top: var(--space-2);
    line-height: 1.45;
  }
  .side .facts {
    margin-top: var(--space-4);
    border-top: 0;
  }
  .ways {
    margin: var(--space-4) 0 0;
  }

  .more {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: var(--space-6);
    border-top: var(--rule-strong) solid var(--ink);
  }
  .more a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-4);
    text-decoration: none;
  }
  .more .next {
    align-items: flex-end;
    text-align: right;
    border-left: var(--rule-width) solid var(--rule);
  }
  .more .t {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .more a:hover .t {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
  }

  @media (max-width: 52rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
  @media (max-width: 34rem) {
    .film {
      float: none;
      width: min(15rem, 100%);
      margin: var(--space-4) 0 0;
    }
    .more {
      grid-template-columns: minmax(0, 1fr);
    }
    .more .next {
      align-items: flex-start;
      text-align: left;
      border-left: 0;
      border-top: var(--rule-width) solid var(--rule);
    }
  }
</style>

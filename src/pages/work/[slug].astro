---
import Base from '../../layouts/Base.astro';
import { live } from '../../data/projects';

export function getStaticPaths() {
  // The list wraps: the first project's "previous" is the last one, and the other way round.
  return live.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: live.at(index - 1) ?? project,
      next: live[(index + 1) % live.length] ?? project,
    },
  }));
}

const { project, prev, next } = Astro.props;
---
<Base
  title={`${project.title} — Victor Saly`}
  description={project.description}
  path={`/work/${project.slug}`}
  image={project.shot}
  imageAlt={project.shotAlt}
>

  <!-- Nothing above the fold is a scroll reveal here: the screenshot and
       title arrive by view transition from the home page and must already
       be in place when it lands. -->
  <header class="intro work-intro">
    <p class="crumb"><a href="/#work"><span aria-hidden="true">&larr;</span> Victor Saly Arcade</a></p>
    <h1 style={`view-transition-name: title-${project.slug}`}>{project.title}</h1>
    <p class="lede">{project.description}</p>
    <ul class="links">
      <li><a class="go" href={project.url}>Open {project.host} &rarr;</a></li>
      <li><a href={project.repo}>Source on GitHub</a></li>
    </ul>
  </header>

  <main id="main">

    <figure class="work-shot">
      <img
        src={project.shot} alt={project.shotAlt} width="800" height="500" decoding="async"
        style={`view-transition-name: shot-${project.slug}`}
      >
    </figure>

    <div class="work-body">
      <section class="work-story reveal">
        {project.film && (
          <figure class="work-film">
            <video
              src={project.film}
              poster={project.filmPoster}
              controls
              playsinline
              preload="none"
              width="1080"
              height="1920"
            >
              <track kind="captions" src={project.filmCaptions} srclang="en" label="English" default />
            </video>
            {project.filmCaption && <figcaption>{project.filmCaption}</figcaption>}
          </figure>
        )}
        {project.story.map((p) => <p>{p}</p>)}
      </section>
      <aside class="work-facts reveal" style="--i:1">
        <h2>Built with</h2>
        <ul class="meta">
          {project.tech.map((t) => <li>{t}</li>)}
        </ul>
        <h2>Links</h2>
        <ul class="work-links">
          <li><a href={project.url}>{project.host}</a></li>
          <li><a href={project.repo}>GitHub repository</a></li>
        </ul>
      </aside>
    </div>

    <nav class="work-nav reveal" aria-label="More projects">
      <a href={`/work/${prev.slug}`}><span aria-hidden="true">&larr;</span> {prev.title}</a>
      <a href="/#work">All projects</a>
      <a href={`/work/${next.slug}`}>{next.title} <span aria-hidden="true">&rarr;</span></a>
    </nav>

  </main>

</Base>

---
/*
 * The home page: whose work this is, in one heavy-ruled masthead, then a contents list of every app by kind,
 * then the work itself as a catalogue of plates, one section per kind, strongest evidence for a client
 * first. Each section ends with that kind's projects that have the source only, as ruled rows. Then how all
 * of it gets made, and the newest writing from the blog.
 */
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import { getAlso, getWork, kinds } from '../lib/projects';
import { latestWriting } from '../lib/writing';

const live = await getWork();
const repos = await getAlso();
const writing = await latestWriting();
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/London',
});
const pad = (n: number): string => String(n).padStart(2, '0');
// Each group with its plates (numbered straight through the page) and its source-only rows.
const groups = kinds
  .map((kind) => ({
    ...kind,
    plates: live
      .map((entry, index) => ({ entry, number: index + 1 }))
      .filter(({ entry }) => entry.data.kind === kind.id),
    rows: repos.filter((entry) => entry.data.kind === kind.id),
  }))
  .filter((group) => group.plates.length + group.rows.length > 0);
---

<Base
  title="Victor Saly — apps, games and tools"
  description="Apps, games and tools by Victor Saly, made in London: a few for clients and paying customers, most for his kids and himself. Each one is live or has its source, with how it was built."
  path="/"
>
  <main id="main" class="frame">
    <div class="masthead">
      <div class="name">
        <h1 class="display">Victor Saly</h1>
        <p class="tagline">I build apps that do one job well.</p>
      </div>
      <div class="intro">
        <p class="personal">
          Apps, games and tools. A few are for clients and paying customers. Most began as something
          my kids or I needed.
        </p>
        <p>
          All of it is my own work, separate from my job at Storm Technologies. Made in London. Most
          of the free ones work offline and need no account.
        </p>
        <p class="reach">
          <a class="control filled" href="mailto:info@victorsaly.com">Say hello</a>
          <a class="control" href="https://www.linkedin.com/in/victorsaly" rel="me">LinkedIn</a>
          <a class="control" href="https://github.com/victorsaly">GitHub</a>
        </p>
      </div>
    </div>

    <nav class="contents" aria-labelledby="apps">
      <h2 class="label" id="apps">The apps, by kind</h2>
      <p class="small quiet count">
        {live.length} live now, numbered, and {repos.length} more with the source only, in grey.
      </p>
      <ul class="groups">
        {
          groups.map((group) => (
            <li>
              <a class="group" href={`#${group.id}`}>
                {group.title}
                <span class="quiet">{group.plates.length + group.rows.length}</span>
              </a>
              <ul class="items">
                {group.plates.map(({ entry, number }) => (
                  <li>
                    <a href={`#work-${entry.id}`}>
                      <span class="n">{pad(number)}</span>
                      {entry.data.title}
                    </a>
                  </li>
                ))}
                {group.rows.map(({ data: row }) => (
                  <li>
                    <a class="source-only" href={`#also-${row.id}`}>
                      <span class="n" aria-hidden="true" />
                      {row.links.map((link) => link.label).join(' and ')}
                      <span class="visually-hidden">(source only)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      groups.map((group) => (
        <section aria-labelledby={group.id} class="kind">
          <h2 class="label" id={group.id}>
            {group.title}
          </h2>
          {group.plates.map(({ entry, number }) => (
            <Plate project={entry} number={number} first={number === 1} />
          ))}
          {group.rows.length > 0 && (
            <ul class="rows">
              {group.rows.map(({ data: project }) => (
                <li id={`also-${project.id}`}>
                  <h3>
                    {project.links.map((link, i) => (
                      <>
                        {i > 0 && ' and '}
                        <a href={link.href}>
                          <mark>{link.label}</mark>
                        </a>
                      </>
                    ))}
                  </h3>
                  <p class="what">{project.summary}</p>
                  <p class="small quiet">Source only. {project.tech.join(', ')}</p>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <section aria-labelledby="made" class="made">
      <h2 class="label" id="made">How these get made</h2>
      <p class="said">A weekend is enough to finish something small, and finish it properly.</p>
      <p>
        Nearly all of this is built with an AI pair: I decide what it should be and why, and review
        every line that lands. Real tests, real accessibility, no analytics. Where I can, each one
        works with the network off and needs no account. How that works is written up on <a
          href="https://blog.victorsaly.com">the blog</a
        >.
      </p>
    </section>
    {
      writing.length > 0 && (
        <section aria-labelledby="writing" class="writing">
          <h2 class="label" id="writing">
            Latest writing
          </h2>
          <ul class="rows">
            {writing.map((post) => (
              <li>
                <h3>
                  <a href={post.link}>
                    <mark>{post.title}</mark>
                  </a>
                </h3>
                <p class="what">{post.summary}</p>
                <p class="small quiet">
                  <time datetime={post.date.toISOString()}>{dateFormat.format(post.date)}</time>
                </p>
              </li>
            ))}
          </ul>
          <p class="small more">
            <a href="https://blog.victorsaly.com/all">Everything on the blog</a>
          </p>
        </section>
      )
    }
  </main>
</Base>

<style>
  /* The masthead: one heavy rule across the page; under it the name and the one line on the left, and on
     the right whose work this is and how to reach me, both ending on the same line. */
  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-4) var(--space-5);
    align-items: end;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
    border-top: var(--rule-heavy) solid var(--ink);
  }
  .personal {
    font-weight: 700;
  }
  .tagline {
    margin: var(--space-3) 0 0;
    max-width: 18ch;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .intro p {
    margin-bottom: var(--space-3);
  }
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }

  .live {
    scroll-margin-top: var(--space-6);
  }
  .live .note {
    margin-bottom: var(--space-4);
  }
  /* The contents: every app, by kind, so the whole body of work reads in one look before the plates. On a
     desk the four kinds stand side by side as columns; on a phone only the kinds show, as jump links. */
  .contents {
    margin-bottom: var(--space-5);
  }
  .count {
    margin: var(--space-2) 0 0;
  }
  .groups {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0 var(--space-5);
    margin: var(--space-3) 0 0;
    padding: 0;
    max-width: none;
  }
  .groups > li {
    border-top: var(--rule-width) solid var(--ink);
  }
  .groups .group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--tap);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
  }
  .groups .group:hover,
  .items a:hover {
    text-decoration: underline;
  }
  .groups .group .quiet {
    font-size: var(--size-small);
    font-variant-numeric: tabular-nums;
  }
  .items {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
  }
  .items a {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding-block: 0.3rem;
    text-decoration: none;
    line-height: 1.35;
  }
  /* A project with the source only: no number, and in the quiet colour, like its row further down. */
  .items .source-only {
    color: var(--quiet);
  }
  .items .n {
    flex: none;
    width: 1.75rem;
    font-size: var(--size-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--quiet);
  }

  /* A group: its label's strong rule opens the first plate, so that plate drops its own. */
  .kind {
    scroll-margin-top: var(--space-6);
  }
  .kind + .kind {
    margin-top: var(--space-5);
  }
  .kind > :global(article.plate:first-of-type) {
    border-top: 0;
  }
  .kind > :global(article.plate) {
    scroll-margin-top: var(--space-6);
  }
  .kind > .rows:first-child,
  .kind > .label + .rows {
    border-top: 0;
  }
  .rows li {
    scroll-margin-top: var(--space-6);
  }

  .made,
  .writing {
    margin-top: var(--space-5);
  }
  /* The label's strong rule already opens this list; its own top hairline would draw a second line. */
  .writing .rows {
    border-top: 0;
  }
  .writing .more {
    margin: var(--space-3) 0 0;
  }
  .writing .more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 700;
  }
  .rows {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    max-width: none;
    border-top: var(--rule-width) solid var(--ink);
  }
  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-4);
    border-bottom: var(--rule-width) solid var(--ink);
  }
  .rows h3 {
    grid-row: span 2;
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.3;
  }
  .rows h3 a {
    text-decoration: none;
  }
  .rows h3 a:hover mark,
  .rows h3 a:focus-visible mark {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
  }
  .rows p {
    margin: 0;
  }
  .rows .what {
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .made .said {
    margin: var(--space-4) 0 var(--space-3);
    max-width: 22ch;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  @media (max-width: 52rem) {
    .masthead {
      grid-template-columns: minmax(0, 1fr);
    }
    /* On a narrow screen the contents keeps only the kinds, two to a row, so the plates come sooner. */
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 var(--space-3);
    }
    .items {
      display: none;
    }
    .rows li {
      grid-template-columns: minmax(0, 1fr);
    }
    .rows h3 {
      grid-row: auto;
    }
  }
  /* A phone: the masthead gives up its top margin and the name and tagline sit tighter. */
  @media (max-width: 34rem) {
    .masthead {
      margin-top: var(--space-4);
      padding-bottom: var(--space-4);
      gap: var(--space-3);
    }
    .tagline {
      margin-top: var(--space-2);
    }
    .intro p {
      margin-bottom: var(--space-2);
    }
    .contents {
      margin-bottom: var(--space-4);
    }
  }
</style>

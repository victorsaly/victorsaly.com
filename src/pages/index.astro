---
/*
 * The home page: whose work this is, in one heavy-ruled masthead, then the work itself as a catalogue of
 * plates, live projects first, each with its real screen. Then the projects with source only, as ruled
 * rows, how all of it gets made, and the newest writing from the blog, where that is written up. The
 * first plate starts inside the first screen on a desk.
 */
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import { getAlso, getWork } from '../lib/projects';
import { latestWriting } from '../lib/writing';

const live = await getWork();
const repos = await getAlso();
const writing = await latestWriting();
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/London',
});
---

<Base
  title="Victor Saly — games, learning tools, and small useful things"
  description="Hobby apps I build in my own time, as personal work: browser games, learning tools for my kids, and utilities that solve one problem well. Most are free, most work offline, and all of them are here."
  path="/"
>
  <div class="frame">
    <header class="masthead">
      <div class="name">
        <h1 class="display">Victor Saly</h1>
        <p class="tagline">I build small web things that do one job well.</p>
      </div>
      <div class="intro">
        <p class="personal">
          These are hobby apps, built in my own time as personal work. Professionally, I work at
          Storm Technologies.
        </p>
        <p>
          Games, learning tools, and utilities, made in London. Most of them started as something my
          kids asked for. Most are free, work offline, and need no account.
        </p>
        <p class="small quiet count">
          {live.length} live projects, and {repos.length} more with the source only.
        </p>
        <p class="reach">
          <a class="control filled" href="mailto:info@victorsaly.com">Say hello</a>
          <a class="control" href="https://www.linkedin.com/in/victorsaly" rel="me">LinkedIn</a>
          <a class="control" href="https://github.com/victorsaly">GitHub</a>
        </p>
      </div>
    </header>
  </div>

  <main id="main" class="frame">
    <section aria-labelledby="live-label" class="live">
      <h2 class="visually-hidden" id="live-label">Live projects</h2>
      {
        live.map((project, index) => (
          <Plate project={project} number={index + 1} first={index === 0} />
        ))
      }
    </section>

    <section aria-labelledby="also" class="also">
      <h2 class="label" id="also">Also built, source only</h2>
      <p class="small quiet note">
        Finished enough to read, without a live link: desktop apps, tools, and things made with the
        kids.
      </p>
      <ul class="rows">
        {
          repos.map(({ data: project }) => (
            <li>
              <h3>
                {project.links.map((link, i) => (
                  <>
                    {i > 0 && ' and '}
                    <a href={link.href}>
                      <mark>{link.label}</mark>
                    </a>
                  </>
                ))}
              </h3>
              <p class="what">{project.summary}</p>
              <p class="small quiet">{project.tech.join(', ')}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="made" class="made">
      <h2 class="label" id="made">How these get made</h2>
      <p class="said">A weekend is enough to finish something small, and finish it properly.</p>
      <p>
        Nearly all of this is built with an AI pair: I decide what it should be and why, and review
        every line that lands. Real tests, real accessibility, no analytics, no accounts, nothing
        loaded from a CDN at runtime. The constraint I keep is that each one has to work with the
        network off. How that works is written up on <a href="https://blog.victorsaly.com"
          >the blog</a
        >.
      </p>
    </section>

    {
      writing.length > 0 && (
        <section aria-labelledby="writing" class="writing">
          <h2 class="label" id="writing">
            Latest writing
          </h2>
          <ul class="rows">
            {writing.map((post) => (
              <li>
                <h3>
                  <a href={post.link}>
                    <mark>{post.title}</mark>
                  </a>
                </h3>
                <p class="what">{post.summary}</p>
                <p class="small quiet">
                  <time datetime={post.date.toISOString()}>{dateFormat.format(post.date)}</time>
                </p>
              </li>
            ))}
          </ul>
          <p class="small more">
            <a href="https://blog.victorsaly.com/all">Everything on the blog</a>
          </p>
        </section>
      )
    }
  </main>
</Base>

<style>
  /* The masthead: one heavy rule across the page; under it the name and the one line on the left, and on
     the right whose work this is and how to reach me, both ending on the same line. */
  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-4) var(--space-5);
    align-items: end;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
    border-top: var(--rule-heavy) solid var(--ink);
  }
  .personal {
    font-weight: 700;
  }
  .tagline {
    margin: var(--space-3) 0 0;
    max-width: 18ch;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .intro p {
    margin-bottom: var(--space-3);
  }
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }

  .also,
  .made,
  .writing {
    margin-top: var(--space-5);
  }
  /* The label's strong rule already opens this list; its own top hairline would draw a second line. */
  .writing .rows {
    border-top: 0;
  }
  .writing .more {
    margin: var(--space-3) 0 0;
  }
  .writing .more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 700;
  }
  .note {
    margin: var(--space-3) 0 0;
  }
  .rows {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    max-width: none;
    border-top: var(--rule-width) solid var(--ink);
  }
  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-4);
    border-bottom: var(--rule-width) solid var(--ink);
  }
  .rows h3 {
    grid-row: span 2;
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.3;
  }
  .rows h3 a {
    text-decoration: none;
  }
  .rows h3 a:hover mark,
  .rows h3 a:focus-visible mark {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
  }
  .rows p {
    margin: 0;
  }
  .rows .what {
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .made .said {
    margin: var(--space-4) 0 var(--space-3);
    max-width: 22ch;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  @media (max-width: 52rem) {
    .masthead {
      grid-template-columns: minmax(0, 1fr);
    }
    .rows li {
      grid-template-columns: minmax(0, 1fr);
    }
    .rows h3 {
      grid-row: auto;
    }
  }
</style>

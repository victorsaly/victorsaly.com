---
/*
 * The home page: whose work this is, in one heavy-ruled masthead with the blog's portrait print, then a cover
 * of every screen at once, then a contents list of every app by kind,
 * then the work itself as a catalogue of plates, one section per kind, strongest evidence for a client
 * first. Then how all of it gets made, and the newest writing from the blog.
 */
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import { getWork, kinds } from '../lib/projects';
import { thumbOf } from '../lib/media';
import { latestWriting } from '../lib/writing';

const live = await getWork();
const writing = await latestWriting();
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/London',
});
const pad = (n: number): string => String(n).padStart(2, '0');
// Each group with its plates, numbered straight through the page.
const groups = kinds
  .map((kind) => ({
    ...kind,
    plates: live
      .map((entry, index) => ({ entry, number: index + 1 }))
      .filter(({ entry }) => entry.data.kind === kind.id),
  }))
  .filter((group) => group.plates.length > 0);
---

<Base
  title="Victor Saly — apps, games and tools"
  description="Apps, games and tools by Victor Saly, made in London: a few for clients and paying customers, most for his kids and himself. Each one is live or has its source, with how it was built."
  path="/"
>
  <main id="main" class="frame">
    <div class="masthead">
      <div class="name">
        <img
          class="portrait"
          src="/portrait.webp"
          alt="Victor Saly, drawn as a linocut print"
          width="480"
          height="480"
          decoding="async"
        />
        <div>
          <h1 class="display">Victor Saly</h1>
          <p class="tagline">I build apps that do one job well.</p>
        </div>
      </div>
      <div class="intro">
        <p class="personal">
          Apps, games and tools. A few are for clients and paying customers. Most began as something
          my kids or I needed.
        </p>
        <p>
          All of it is my own work, separate from my job at Storm Technologies. Made in London. Most
          of the free ones work offline and need no account.
        </p>
        <p class="reach">
          <a class="control filled" href="mailto:info@victorsaly.com">Say hello</a>
          <a class="control" href="https://www.linkedin.com/in/victorsaly" rel="me">LinkedIn</a>
          <a class="control" href="https://github.com/victorsaly">GitHub</a>
        </p>
      </div>
    </div>

    <!-- The cover: every screen at once, like the front of a printed catalogue, before a word is read.
         It repeats what the contents list says in words, so it is hidden from screen readers and the
         keyboard; with a mouse, each screen jumps to its plate. -->
    <div class="cover" aria-hidden="true" style={`--cols: ${Math.ceil(live.length / 2)}`}>
      {
        live.map((entry, index) => (
          <a href={`#work-${entry.id}`} tabindex="-1">
            <img src={thumbOf(entry.data.shot)} alt="" width="400" height="250" decoding="async" />
            <span class="n">{pad(index + 1)}</span>
          </a>
        ))
      }
    </div>

    <nav class="contents" aria-labelledby="apps">
      <h2 class="label" id="apps">The apps, by kind</h2>
      <p class="small quiet count">
        {live.length} live now, each with its page on how it was built.
      </p>
      <ul class="groups">
        {
          groups.map((group) => (
            <li>
              <a class="group" href={`#${group.id}`}>
                {group.title}
                <span class="quiet">{group.plates.length}</span>
              </a>
              <ul class="items">
                {group.plates.map(({ entry, number }) => (
                  <li>
                    <a href={`#work-${entry.id}`}>
                      <span class="n">{pad(number)}</span>
                      {entry.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      groups.map((group) => (
        <section aria-labelledby={group.id} class="kind">
          <h2 class="label" id={group.id}>
            {group.title}
          </h2>
          {group.plates.map(({ entry, number }) => (
            <Plate project={entry} number={number} first={number === 1} />
          ))}
        </section>
      ))
    }

    <section aria-labelledby="made" class="made">
      <h2 class="label" id="made">How these get made</h2>
      <p class="said">A weekend is enough to finish something small, and finish it properly.</p>
      <p>
        Nearly all of this is built with an AI pair: I decide what it should be and why, and review
        every line that lands. Real tests, real accessibility, no analytics. Where I can, each one
        works with the network off and needs no account. How that works is written up on <a
          href="https://blog.victorsaly.com">the blog</a
        >.
      </p>
    </section>
    {
      writing.length > 0 && (
        <section aria-labelledby="writing" class="writing">
          <h2 class="label" id="writing">
            Latest writing
          </h2>
          <ul class="rows">
            {writing.map((post) => (
              <li>
                <h3>
                  <a href={post.link}>
                    <mark>{post.title}</mark>
                  </a>
                </h3>
                <p class="what">{post.summary}</p>
                <p class="small quiet">
                  <time datetime={post.date.toISOString()}>{dateFormat.format(post.date)}</time>
                </p>
              </li>
            ))}
          </ul>
          <p class="small more">
            <a href="https://blog.victorsaly.com/all">Everything on the blog</a>
          </p>
        </section>
      )
    }
  </main>

  <!-- The player: one dialog for every plate's Watch the intro. It is a modal because a film with sound
       wants the reader's whole attention, and Esc or Close hands the page back where they left it. -->
  <dialog class="player" aria-labelledby="player-title">
    <div class="bar">
      <h2 id="player-title">The intro</h2>
      <button type="button" class="control" data-close>Close</button>
    </div>
    <video controls playsinline preload="none">
      <track kind="captions" srclang="en" label="English" default />
    </video>
  </dialog>
</Base>

<style>
  /* The masthead: one heavy rule across the page; under it the name and the one line on the left, and on
     the right whose work this is and how to reach me, both ending on the same line. */
  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-4) var(--space-5);
    align-items: end;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
    border-top: var(--rule-heavy) solid var(--ink);
  }
  /* The portrait print beside the name, as on the blog's home page. In dark mode a print keeps its paper,
     dimmed, with a paper margin (the --print tokens), because inverting a linocut turns the face dark. */
  .name {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
  }
  .portrait {
    flex: none;
    width: clamp(6.5rem, 4rem + 9vw, 12rem);
    height: auto;
    padding: var(--print-pad);
    background: var(--print-paper);
    filter: var(--print-filter);
  }
  .personal {
    font-weight: 700;
  }
  .tagline {
    margin: var(--space-3) 0 0;
    max-width: 18ch;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .intro p {
    margin-bottom: var(--space-3);
  }
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }

  .live {
    scroll-margin-top: var(--space-6);
  }
  .live .note {
    margin-bottom: var(--space-4);
  }
  /* The cover: every screen small, two rows on a desk (as many columns as half the projects), each in the
     hairline frame the plates use, its number under it. Pointing at one draws its frame in the strong rule.
     On a phone it is one row you swipe. */
  .cover {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-3) var(--space-2);
    margin-bottom: var(--space-5);
  }
  .cover a {
    display: block;
    text-decoration: none;
  }
  .cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    outline: var(--rule-width) solid var(--ink);
    outline-offset: 0;
    transition: outline-width var(--duration-press) var(--ease-out);
  }
  .cover a:hover img {
    outline-width: var(--rule-strong);
  }
  .cover .n {
    display: block;
    margin-top: var(--space-1);
    font-size: 0.8125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--quiet);
  }

  /* The contents: every app, by kind, so the whole body of work reads in one look before the plates. On a
     desk the four kinds stand side by side as columns; on a phone only the kinds show, as jump links. */
  .contents {
    margin-bottom: var(--space-5);
  }
  .count {
    margin: var(--space-2) 0 0;
  }
  .groups {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0 var(--space-5);
    margin: var(--space-3) 0 0;
    padding: 0;
    max-width: none;
  }
  .groups > li {
    border-top: var(--rule-width) solid var(--ink);
  }
  .groups .group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--tap);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
  }
  .groups .group:hover,
  .items a:hover {
    text-decoration: underline;
  }
  .groups .group .quiet {
    font-size: var(--size-small);
    font-variant-numeric: tabular-nums;
  }
  .items {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
  }
  .items a {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding-block: 0.3rem;
    text-decoration: none;
    line-height: 1.35;
  }
  .items .n {
    flex: none;
    width: 1.75rem;
    font-size: var(--size-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--quiet);
  }

  /* A group: its label's strong rule opens the first plate, so that plate drops its own. */
  .kind {
    scroll-margin-top: var(--space-6);
  }
  .kind + .kind {
    margin-top: var(--space-5);
  }
  .kind > :global(article.plate:first-of-type) {
    border-top: 0;
  }
  .kind > :global(article.plate) {
    scroll-margin-top: var(--space-6);
  }

  .made,
  .writing {
    margin-top: var(--space-5);
  }
  /* The label's strong rule already opens this list; its own top hairline would draw a second line. */
  .writing .rows {
    border-top: 0;
  }
  .writing .more {
    margin: var(--space-3) 0 0;
  }
  .writing .more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 700;
  }
  .rows {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    max-width: none;
    border-top: var(--rule-width) solid var(--ink);
  }
  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-4);
    border-bottom: var(--rule-width) solid var(--ink);
  }
  .rows h3 {
    grid-row: span 2;
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.3;
  }
  .rows h3 a {
    text-decoration: none;
  }
  .rows h3 a:hover mark,
  .rows h3 a:focus-visible mark {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
  }
  .rows p {
    margin: 0;
  }
  .rows .what {
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .made .said {
    margin: var(--space-4) 0 var(--space-3);
    max-width: 22ch;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  @media (max-width: 52rem) {
    .masthead {
      grid-template-columns: minmax(0, 1fr);
    }
    /* On a narrow screen the contents keeps only the kinds, two to a row, so the plates come sooner. */
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 var(--space-3);
    }
    .items {
      display: none;
    }
    .rows li {
      grid-template-columns: minmax(0, 1fr);
    }
    .rows h3 {
      grid-row: auto;
    }
  }
  @media (max-width: 52rem) {
    .cover {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 9.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      padding: 3px 3px var(--space-2);
      margin-inline: -3px;
      scrollbar-width: thin;
      scrollbar-color: var(--quiet) transparent;
    }
    .cover a {
      scroll-snap-align: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover img {
      transition: none;
    }
  }
  /* A phone: the masthead gives up its top margin and the name and tagline sit tighter. */
  @media (max-width: 34rem) {
    .masthead {
      margin-top: var(--space-4);
      padding-bottom: var(--space-4);
      gap: var(--space-3);
    }
    .tagline {
      margin-top: var(--space-2);
    }
    .intro p {
      margin-bottom: var(--space-2);
    }
    .contents {
      margin-bottom: var(--space-4);
    }
  }

  /* The player, in the page's hand: paper, a strong ink frame, no radius and no shadow. A portrait film
     gets a tall, narrow player; a landscape one a wide one. */
  .player {
    width: min(60rem, calc(100vw - 2 * var(--pad)));
    max-height: calc(100dvh - 2 * var(--space-4));
    padding: var(--space-3);
    border: var(--rule-strong) solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }
  /* Portrait: the height decides. The film is as tall as the screen allows and the player wraps it. */
  .player.portrait {
    width: fit-content;
    max-width: calc(100vw - 2 * var(--pad));
  }
  .player.portrait video {
    width: auto;
    height: min(46rem, calc(100dvh - 11rem));
    max-width: 100%;
    aspect-ratio: 9 / 16;
    margin-inline: auto;
  }
  .player.portrait h2 {
    font-size: 1.125rem;
  }
  .player::backdrop {
    background: rgb(0 0 0 / 0.72);
  }
  .player .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .player h2 {
    margin: 0;
    font-size: var(--size-h2);
    line-height: var(--leading-tight);
  }
  .player video {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 11rem);
    background: #000;
  }
</style>

<script>
  // Watch the intro: plays a plate's film in the one dialog. The button is a real link to the film on the
  // project's page, so it still works if this script does not run.
  const player = document.querySelector<HTMLDialogElement>('dialog.player');
  const video = player?.querySelector('video');
  const title = player?.querySelector('h2');
  const track = video?.querySelector('track');
  if (player && video && title && typeof player.showModal === 'function') {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('a.watch[data-film]')) {
      link.addEventListener('click', (event) => {
        const { film, poster, captions, shape, title: name } = link.dataset;
        if (!film) return;
        event.preventDefault();
        title.textContent = `${name ?? ''}: the intro`;
        player.classList.toggle('portrait', shape === 'portrait');
        if (track) track.src = captions ?? '';
        video.poster = poster ?? '';
        video.src = film;
        player.showModal();
        void video.play().catch(() => {
          /* autoplay with sound was refused: the controls are there */
        });
      });
    }
    // Closing by the button, Esc or a click on the backdrop all stop the film and let go of the file.
    player.querySelector('[data-close]')?.addEventListener('click', () => player.close());
    player.addEventListener('click', (event) => {
      if (event.target === player) player.close();
    });
    player.addEventListener('close', () => {
      video.pause();
      video.removeAttribute('src');
      video.load();
    });
  }
</script>
